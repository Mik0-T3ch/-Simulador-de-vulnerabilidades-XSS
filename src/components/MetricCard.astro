---
interface Props {
  title: string;
  value: string | number;
  change?: string;
  icon?: string;
  variant?: 'pink' | 'purple' | 'pastelPink' | 'red' | 'amber';
}

const { title, value, change, icon, variant = 'purple' } = Astro.props;

const borderVariants = {
  purple: 'border-cyber-purple/40 hover:border-cyber-accent shadow-neon-purple/20',
  pink: 'border-cyber-pink/40 hover:border-cyber-pink shadow-neon-pink/20',
  pastelPink: 'border-cyber-pastelPink/30 hover:border-cyber-pastelPink',
  red: 'border-cyber-danger/40 hover:border-cyber-danger shadow-red-950/40',
  amber: 'border-cyber-warning/40 hover:border-cyber-warning'
};

const textVariants = {
  purple: 'text-cyber-accent',
  pink: 'text-cyber-pink',
  pastelPink: 'text-cyber-pastelPink',
  red: 'text-cyber-danger',
  amber: 'text-cyber-warning'
};
---

<div class={`p-5 rounded-xl bg-cyber-card/90 border ${borderVariants[variant]} backdrop-blur-md transition-all duration-300 hover:-translate-y-0.5 relative overflow-hidden group`}>
  <div class="flex items-center justify-between mb-3">
    <span class="text-xs font-mono uppercase tracking-wider text-slate-400 font-semibold">{title}</span>
    {icon && (
      <div class={`p-2 rounded-lg bg-cyber-panel/90 ${textVariants[variant]}`}>
        <Fragment set:html={icon} />
      </div>
    )}
  </div>
  <div class="flex items-baseline justify-between">
    <div class={`text-3xl font-mono font-bold tracking-tight ${textVariants[variant]}`} id={`metric-${title.toLowerCase().replace(/\s+/g, '-')}`}>
      {value}
    </div>
    {change && (
      <span class="text-xs font-mono text-slate-300 bg-cyber-panel/80 px-2 py-1 rounded border border-cyber-border/80">
        {change}
      </span>
    )}
  </div>
</div>
