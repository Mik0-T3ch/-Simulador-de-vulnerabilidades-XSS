---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Ofuscador & Codificador XSS | Simulador de Vulnerabilidades">
  <div class="space-y-8">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-cyber-border/80 pb-5">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold font-mono text-white flex items-center gap-3">
          <span class="p-2 rounded-lg bg-purple-500/10 border border-purple-500/30 text-purple-400">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>
          </span>
          Ofuscador de Payloads & Bypass de Filtros
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1 font-mono">
          Transforma vectores XSS a múltiples representaciones de codificación para evadir filtros de validación y WAFs ingenuos.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <div class="lg:col-span-5 space-y-4">
        <div class="rounded-xl bg-cyber-card border border-cyber-border p-5 space-y-4">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-white uppercase">Vector Base a Transformar</span>
            <span class="text-[10px] font-mono text-slate-400">Entrada RAW</span>
          </div>

          <div>
            <textarea
              id="encoder-input"
              rows="4"
              class="w-full p-3 rounded-lg bg-cyber-bg border border-cyber-border font-mono text-xs text-cyber-accent focus:border-cyber-accent focus:outline-none resize-none leading-relaxed"
              placeholder="<script>alert(1)</script>"
            >&lt;script&gt;alert('XSS')&lt;/script&gt;</textarea>
          </div>

          <div class="flex flex-wrap gap-1.5">
            <button class="encoder-preset px-2 py-1 rounded bg-cyber-panel text-slate-300 hover:text-white text-[11px] font-mono border border-cyber-border/60" data-code="<script>alert(1)</script>">Tag Script</button>
            <button class="encoder-preset px-2 py-1 rounded bg-cyber-panel text-slate-300 hover:text-white text-[11px] font-mono border border-cyber-border/60" data-code="<img src=x onerror=alert('Bypass')>">Img OnError</button>
            <button class="encoder-preset px-2 py-1 rounded bg-cyber-panel text-slate-300 hover:text-white text-[11px] font-mono border border-cyber-border/60" data-code="javascript:alert(document.cookie)">URI Scheme</button>
          </div>
        </div>

        <div class="rounded-xl bg-cyber-card border border-cyber-border p-5 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono font-bold text-white uppercase">Comprobador de Evasión (WAF Simulator)</span>
          </div>
          
          <div class="space-y-2.5 font-mono text-xs" id="waf-filter-results"></div>
        </div>
      </div>

      <div class="lg:col-span-7 space-y-4">
        
        <div class="grid grid-cols-1 gap-4">
          
          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-cyber-accent uppercase">HTML Entities (Decimal)</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-cyber-accent" data-target="out-html-dec">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-html-dec"></div>
          </div>

          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-cyber-glow uppercase">HTML Entities (Hexadecimal)</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-cyber-glow" data-target="out-html-hex">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-html-hex"></div>
          </div>

          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-purple-400 uppercase">URL Encoding & Double URL</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-purple-400" data-target="out-url-double">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-url-double"></div>
          </div>

          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-400 uppercase">Unicode Escape Sequence (\u00xx)</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-amber-400" data-target="out-unicode">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-unicode"></div>
          </div>

          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-red-400 uppercase">JavaScript String.fromCharCode()</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-red-400" data-target="out-charcode">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-charcode"></div>
          </div>

          <div class="p-4 rounded-xl bg-cyber-card border border-cyber-border space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-emerald-400 uppercase">Data URI Scheme (Base64)</span>
              <button class="copy-btn text-[11px] font-mono text-slate-400 hover:text-emerald-400" data-target="out-datauri">Copiar</button>
            </div>
            <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/80 font-mono text-xs text-slate-300 break-all" id="out-datauri"></div>
          </div>

        </div>

      </div>

    </div>

  </div>
</Layout>

<script>
  import {
    toHtmlEntitiesDecimal,
    toHtmlEntitiesHex,
    toUrlEncode,
    toDoubleUrlEncode,
    toUnicodeEscape,
    toBase64DataUri,
    toJsCharCode,
    testFilterBypass
  } from '../../utils/encoder.js';

  function updateEncodings() {
    const input = document.getElementById('encoder-input');
    if (!input) return;

    const raw = input.value;

    const decElem = document.getElementById('out-html-dec');
    const hexElem = document.getElementById('out-html-hex');
    const urlElem = document.getElementById('out-url-double');
    const uniElem = document.getElementById('out-unicode');
    const charElem = document.getElementById('out-charcode');
    const dataElem = document.getElementById('out-datauri');

    if (decElem) decElem.textContent = toHtmlEntitiesDecimal(raw);
    if (hexElem) hexElem.textContent = toHtmlEntitiesHex(raw);
    if (urlElem) urlElem.textContent = toDoubleUrlEncode(raw);
    if (uniElem) uniElem.textContent = toUnicodeEscape(raw);
    if (charElem) charElem.textContent = toJsCharCode(raw);
    if (dataElem) dataElem.textContent = toBase64DataUri(raw);

    updateWafTests(raw);
  }

  function updateWafTests(payload) {
    const container = document.getElementById('waf-filter-results');
    if (!container) return;

    const filters = ['simple_script', 'case_sensitive', 'no_quotes', 'no_alert'];
    container.innerHTML = filters.map(f => {
      const res = testFilterBypass(payload, f);
      const isBypassed = res.bypassed;
      return `
        <div class="p-2.5 rounded bg-cyber-bg border border-cyber-border/60 flex items-center justify-between">
          <div>
            <div class="text-slate-200 font-semibold">${res.name}</div>
            <div class="text-[10px] text-slate-500 truncate max-w-[220px]">Salida: ${res.sanitized || '(Vacio)'}</div>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold ${
            isBypassed ? 'bg-emerald-950 text-emerald-300 border border-emerald-500' : 'bg-red-950 text-red-300 border border-red-500'
          }">
            ${isBypassed ? 'BYPASS EXITOSO' : 'BLOQUEADO'}
          </span>
        </div>
      `;
    }).join('');
  }

  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('encoder-input');
    if (input) input.addEventListener('input', updateEncodings);

    document.querySelectorAll('.encoder-preset').forEach(btn => {
      btn.addEventListener('click', () => {
        const code = btn.getAttribute('data-code');
        if (input && code) {
          input.value = code;
          updateEncodings();
        }
      });
    });

    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const target = targetId ? document.getElementById(targetId) : null;
        if (target && target.textContent) {
          navigator.clipboard.writeText(target.textContent);
          if (window.showToast) {
            window.showToast('Copiado al portapapeles', 'success');
          }
        }
      });
    });

    updateEncodings();
  });
</script>
